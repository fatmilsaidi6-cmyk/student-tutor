# Copy this file to `.env` and fill in your key to enable the cloud (hybrid) backend.
# Without a key, the app runs fully locally (private, offline, slower).

# --- Cloud (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini

# --- Local (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=Qwen-Hermes:latest
# Seconds to wait for a local answer (CPU inference can be slow).
OLLAMA_TIMEOUT=600

# --- Server / security ---
# Comma-separated browser origins allowed to call the API (dev server).
# The single-server build is same-origin and needs no entry here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Max AI requests per client IP per minute (0 disables rate limiting).
RATE_LIMIT_PER_MINUTE=30
# Shared access code for the AI endpoints. Leave empty for open, local use.
# When set, clients must send it as X-API-Key or "Authorization: Bearer <key>".
API_KEY=

# --- Upload guardrails (untrusted files) ---
# Reject images with more than this many pixels (decompression-bomb guard).
MAX_IMAGE_PIXELS=40000000
# Reject PDFs with more pages than this.
MAX_PDF_PAGES=20

# --- OAuth sign-in (optional; enables "sign in with ..." for a public app) ---
# Session cookie signing key. REQUIRED in production: use a long random string.
SESSION_SECRET=dev-insecure-change-me
# Public base URL of the deployment; used to build OAuth redirect URIs and to
# mark the session cookie Secure. e.g. https://study-buddy.fly.dev
PUBLIC_BASE_URL=
# Google OAuth app credentials (leave blank to disable Google sign-in).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth app credentials (leave blank to disable GitHub sign-in).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional comma-separated allowlist of emails. Empty = allow any signed-in user.
ALLOWED_EMAILS=
# Trust X-Forwarded-For / Fly-Client-IP for the client IP (set true behind a proxy).
TRUST_PROXY=false
